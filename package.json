{
  "name": "dsh-llm-manage",
  "version": "0.3.14",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "private": false,
  "type": "module",
  "description": "Model inventory, health reasons and quota fallback for DSH LLM provider routes",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "verify-env.mjs",
    "verify.mjs",
    "verify-client.mjs",
    "verify-browser.mjs",
    "verify-live.mjs",
    "screenshot.mjs",
    "tools/check-upstream.mjs",
    "docs/upstream-parity.json",
    "docs/upstream-parity.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "verify": "node verify.mjs && node verify-client.mjs && node verify-browser.mjs",
    "check:upstream": "node tools/check-upstream.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "PhilYue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilYue/dsh-llm-manage.git"
  },
  "homepage": "https://github.com/PhilYue/dsh-llm-manage#readme",
  "bugs": {
    "url": "https://github.com/PhilYue/dsh-llm-manage/issues"
  }
}
